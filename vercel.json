{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/apolo-control-frontend/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://control-production-915e.up.railway.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
